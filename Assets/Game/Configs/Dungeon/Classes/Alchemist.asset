  m_Script: {fileID: 11500000, guid: d988ee4bac2acf74b80699d6e83c0b70, type: 3}
  m_Name: Alchemist
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.Dungeon.ClassConfig
  _id: 2
  _displayName: Alchemist
  _description: 'A guild alchemist''s apprentice thrown out on the street. No money
    for dear reagents, so he went into the vein for ossarite: above, it buys everything
    else.'
  _baseStats:
    Strength: 14
    Vitality: 15
    Spirit: 13
    Knowledge: 18
    Agility: 15
    Dexterity: 15
  _color: {r: 0.85, g: 0.62, b: 0.25, a: 1}
  _bodyColor: {r: 1, g: 1, b: 1, a: 1}
  _skills:
  - {fileID: 11400000, guid: b2534023b64a374448932d429459fd3b, type: 2}
  - {fileID: 11400000, guid: f78216dd484ebf249b1d8881f6172ad2, type: 2}
  - {fileID: 11400000, guid: 10c2cd723b2633449bdab953dfa022dc, type: 2}
  - {fileID: 11400000, guid: 6175c0081a3aab94c81add2592896973, type: 2}
  - {fileID: 11400000, guid: 73912ac4cf45ebe4e881208d008811ae, type: 2}
  - {fileID: 11400000, guid: 099a6e11bcc5923408dc3708c3455eb0, type: 2}
  - {fileID: 11400000, guid: ffc0755ece7ed58488f44953c77ca6fe, type: 2}
  - {fileID: 11400000, guid: 6780f749ee93fdc4bb0d7ca6e89b0a16, type: 2}
  _spells: []
  _perks:
  - _name: Potion Lore
    _description: 'Potions last 30% longer.

      <i><color=#a89f8a>"The guild threw
      out the apprentice but kept the training."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 6a9144d733f72f046a4632de5fef58f5, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 14
    _value: 0.3
  - _name: Provident
    _description: '+1 potion in every stack.

      <i><color=#a89f8a>"Vials packed
      in straw do not break."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 5aa871f48bf729c4a80f2ceb3dae45e1, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 15
    _value: 1
  - _name: Iron Stomach
    _description: 'Poison hurts you 50% less.

      <i><color=#a89f8a>"The master
      called it spoiled reagents. He called it breakfast."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 24f288f9f335c5c40963128d78d9f702, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 16
    _value: 0.5
  - _name: Healthy Spirit
    _description: 'Allies within 6m get +3 Vitality.

      <i><color=#a89f8a>"Gave
      the convicts a strong infusion before every shift."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 770b8114b79334343b03f83bbbde07b4, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 17
    _value: 3
  - _name: Generous Flask
    _description: 'A healing potion you drink heals allies within 4m for half its
      effect.

      <i><color=#a89f8a>"One flask for everyone."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: eee59323dbc3f884999845f0ba3f495c, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 18
    _value: 0.5
  - _name: Calm Hands
    _description: 'Allies within 6m drink and bandage 20% faster.

      <i><color=#a89f8a>"Don''t
      hurry. You''ll make it."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 66312aebf153f264aa29665ced886fba, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 19
    _value: 20
  - _name: Pure Blood
    _description: 'Every heal of yours, on you or allies, cures poison.

      <i><color=#a89f8a>"Drive
      the poison out first, then patch."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: ea3f78df158edc740ac94114ade217ce, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 20
    _value: 1
  - _name: Caustic Mix
    _description: 'Foes caught in your blast take 10% more damage from everyone for
      4s.

      <i><color=#a89f8a>"Steel takes a blow. Not acid."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: aa783d0356f9363419613ad4287cd181, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 21
    _value: 10
  - _name: Strong Charge
    _description: '+20% damage of your flasks, blast and fire.

      <i><color=#a89f8a>"A
      pinch is for cowards."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 0465012d9ba79ba40b8c4c5d22877d16, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 22
    _value: 0.2
  - _name: Wide Spread
    _description: 'Your blasts and pools are 25% wider.

      <i><color=#a89f8a>"Ground
      glass in the flask: the splinters fly farther."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 60003a6b68a236442a421d74b13fcb90, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 23
    _value: 0.25
  - _name: Used to the Roar
    _description: 'Your own blasts and fire hurt you 50% less (allies get no discount).

      <i><color=#a89f8a>"What?
      Speak up."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 2a1b762f62b7b054cbb844ad209c4a3c, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 24
    _value: 0.5
  - _name: Accustomed
    _description: 'Side effects of your mixtures last half as long.

      <i><color=#a89f8a>"Poison
      is a dose. A dose is a habit."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 518407e8a22a5d849ab12a5eea95a803, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 25
    _value: 0.5
  - _name: Double Dose
    _description: 'Buffs of your mixtures last 50% longer.

      <i><color=#a89f8a>"One
      to try. The second for real."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: c3cc1d7cdc4cb1e408ef8d7638327cbf, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 26
    _value: 0.5
  - _name: Sinewy
    _description: '+3 Strength.

      <i><color=#a89f8a>"Lean is not weak."</color></i>'
    _modifiers:
    - Stat: 0
      Value: 3
    _icon: {fileID: 21300000, guid: 5cca3ffc9a74259469350dee4d823bb2, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Buzz
    _description: 'While any of your mixtures works you take 15% less damage.

      <i><color=#a89f8a>"Pain
      is duller in a daze."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 06c579e8b8666184bb2af63040f3ab0a, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 27
    _value: 0.15
  _subclasses:
  - _name: Physician
    _description: 'Support: heals the squad. Thrown out for treating convicts for
      free.'
    _color: {r: 0.55, g: 0.95, b: 0.55, a: 1}
