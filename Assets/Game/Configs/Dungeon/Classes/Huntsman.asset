  - {fileID: 11400000, guid: 7b2f0e08bfd40f641b129811df057fe3, type: 2}
  _spells: []
  _perks:
  - _name: Beast Habit
    _description: '+10% damage to monsters (not to players).

      <i><color=#a89f8a>"A
      beast is a beast, however much stone grows in it."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 3607947fdf893f540a72a803a1c37df0, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 28
    _value: 0.1
  - _name: Knack
    _description: 'Draw bows and reload crossbows 15% faster.

      <i><color=#a89f8a>"The
      hand remembers. The head may sleep."</color></i>'
    _modifiers:
    - Stat: 17
      Value: 15
    _icon: {fileID: 21300000, guid: b2ab635919c6f50499143149773a2d25, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Forest Hardened
    _description: '+3 Agility.

      <i><color=#a89f8a>"Thirty winters after deer
      through windfall."</color></i>'
    _modifiers:
    - Stat: 4
      Value: 3
    _icon: {fileID: 21300000, guid: 33fe3f149fc66c84aab4383d5dc7545a, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Taut String
    _description: '+15% damage of ranged weapons.

      <i><color=#a89f8a>"Grandfather''s
      bow. My string."</color></i>'
    _modifiers:
    - Stat: 16
      Value: 0.15
    _icon: {fileID: 21300000, guid: 8059c6ba3fcdf1f45bd5ab26e18e9b01, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Long Shot
    _description: 'Shots hit harder with distance, up to +20% at 20m and beyond.

      <i><color=#a89f8a>"Closer
      is for butchers."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 43131907fa3891f46a611ce250dd425b, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 29
    _value: 0.2
  - _name: Finishing Shot
    _description: '+20% damage to targets below 30% health.

      <i><color=#a89f8a>"A
      wounded beast is the most dangerous. Give it no time."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 8e711d2388dec294fab436be8d04d2c9, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 30
    _value: 0.2
  - _name: Steady Hand
    _description: '+3 Dexterity.

      <i><color=#a89f8a>"Don''t shake. He doesn''t."</color></i>'
    _modifiers:
    - Stat: 5
      Value: 3
    _icon: {fileID: 21300000, guid: 245968cdcca556a499d729928af42cf5, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Cat's Eye
    _description: 'Your torch lights 50% farther.

      <i><color=#a89f8a>"Nights
      are darker in the woods. Used to it."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 18bd1a247fb061a4a87100078e876737, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 31
    _value: 0.5
  - _name: Trap Sense
    _description: 'Traps hurt you 50% less.

      <i><color=#a89f8a>"The same snare,
      only of stone."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: ad1c17fd7e8c6554ba51652a120db407, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 32
    _value: 0.5
  - _name: Vein Expert
    _description: 'Search chests and bodies 30% faster.

      <i><color=#a89f8a>"Skin
      it quick, before they come."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: f868efca3a0bc5847a385d6d1972beb1, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 33
    _value: 0.3
  - _name: Hunter's Mark
    _description: 'Your hits mark the target for 5s: everyone deals 10% more damage
      to it.

      <i><color=#a89f8a>"That one. The lame one."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 55b78c91d4b51794e92789cb77311ac6, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 34
    _value: 10
  - _name: Heavy Jaws
    _description: 'Your trap holds 1s longer.

      <i><color=#a89f8a>"The wolf
      chewed off its paw. These won''t."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 95e0294e2bf720741a4a04656c0d21ac, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 35
    _value: 1
  - _name: Poisoned Teeth
    _description: 'Whoever steps into your trap is poisoned for 4s.

      <i><color=#a89f8a>"Wolfsbane.
      The dead don''t care, the living have enough."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 08e05605da2eaf14dadc7aae9b5dbcf5, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 36
    _value: 4
  - _name: Iron Stock
    _description: '+1 trap on the ground at once.

      <i><color=#a89f8a>"Carries
      half a pood of iron on his back."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 0bf9e6a95cf56f941853cb55598b0956, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 37
    _value: 1
  - _name: Prey in the Snare
    _description: '+15% damage to rooted and slowed targets.

      <i><color=#a89f8a>"Caught?
      Don''t struggle."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: ee5c5f7a4c479d346876525db9722085, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 38
    _value: 0.15
  _subclasses:
  - _name: Marksman
    _description: Damage from afar. The last hunter of his village.
