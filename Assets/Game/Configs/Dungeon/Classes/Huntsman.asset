  m_Script: {fileID: 11500000, guid: d988ee4bac2acf74b80699d6e83c0b70, type: 3}
  m_Name: Huntsman
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.Dungeon.ClassConfig
  _id: 4
  _displayName: Huntsman
  _description: 'A hunter from the dead forests: dust from the spoil heaps poisoned
    the woods above and the game left. Now his game is the creatures of the vein,
    and the House of Scales buys the trophies.'
  _baseStats:
    Strength: 12
    Vitality: 13
    Spirit: 8
    Knowledge: 15
    Agility: 21
    Dexterity: 21
  _color: {r: 0.45, g: 0.72, b: 0.35, a: 1}
  _bodyColor: {r: 1, g: 1, b: 1, a: 1}
