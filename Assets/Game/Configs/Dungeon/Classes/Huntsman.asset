  - {fileID: 11400000, guid: 7b2f0e08bfd40f641b129811df057fe3, type: 2}
  _spells: []
  _perks:
  - _name: Beast Habit
    _description: '+10% damage to monsters (not to players).

      <i><color=#a89f8a>"A
      beast is a beast, however much stone grows in it."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: af971d12010896c4983a646b1a3172c0, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 28
    _value: 0.1
  - _name: Knack
    _description: 'Draw bows and reload crossbows 15% faster.

      <i><color=#a89f8a>"The
      hand remembers. The head may sleep."</color></i>'
    _modifiers:
    - Stat: 17
      Value: 15
    _icon: {fileID: 21300000, guid: 85651932113a01146a42099cce4274be, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Forest Hardened
    _description: '+3 Agility.

      <i><color=#a89f8a>"Thirty winters after deer
      through windfall."</color></i>'
    _modifiers:
    - Stat: 4
      Value: 3
    _icon: {fileID: 21300000, guid: 0989ac11af6761645a528b9a7dc7e411, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Taut String
    _description: '+15% damage of ranged weapons.

      <i><color=#a89f8a>"Grandfather''s
      bow. My string."</color></i>'
    _modifiers:
    - Stat: 16
      Value: 0.15
    _icon: {fileID: 21300000, guid: 4696088df639a1a4093dda0fc8840196, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Long Shot
    _description: 'Shots hit harder with distance, up to +20% at 20m and beyond.

      <i><color=#a89f8a>"Closer
      is for butchers."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: b065910e8f01d7a439ce3eed107e1980, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 29
    _value: 0.2
  - _name: Finishing Shot
    _description: '+20% damage to targets below 30% health.

      <i><color=#a89f8a>"A
      wounded beast is the most dangerous. Give it no time."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 1d66939847147474c8ee85b585284d3f, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 30
    _value: 0.2
  - _name: Steady Hand
    _description: '+3 Dexterity.

      <i><color=#a89f8a>"Don''t shake. He doesn''t."</color></i>'
    _modifiers:
    - Stat: 5
      Value: 3
    _icon: {fileID: 21300000, guid: 97c3dd95e14acfa43b346d7714ae5e5b, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Cat's Eye
    _description: 'Your torch lights 50% farther.

      <i><color=#a89f8a>"Nights
      are darker in the woods. Used to it."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 21f729643229f6c4fa8f3ed99fee283d, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 31
    _value: 0.5
  - _name: Trap Sense
    _description: 'Traps hurt you 50% less.

      <i><color=#a89f8a>"The same snare,
      only of stone."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: c7420c9525259bc4f8d8f42a44f62b79, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 32
    _value: 0.5
  - _name: Vein Expert
    _description: 'Search chests and bodies 30% faster.

      <i><color=#a89f8a>"Skin
      it quick, before they come."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: cbec0aec635425549a2c4013c34d2237, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 33
    _value: 0.3
  - _name: Hunter's Mark
    _description: 'Your hits mark the target for 5s: everyone deals 10% more damage
      to it.

      <i><color=#a89f8a>"That one. The lame one."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 8b06cde24e2518a4b9ea9b05fc7aebe9, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 34
    _value: 10
  - _name: Heavy Jaws
    _description: 'Your trap holds 1s longer.

      <i><color=#a89f8a>"The wolf
      chewed off its paw. These won''t."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: dd4387b063ff7904aafec9f8b46f9196, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 35
    _value: 1
  - _name: Poisoned Teeth
    _description: 'Whoever steps into your trap is poisoned for 4s.

      <i><color=#a89f8a>"Wolfsbane.
      The dead don''t care, the living have enough."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 41a09d19c0b9a334084caceb93e291ee, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 36
    _value: 4
  - _name: Iron Stock
    _description: '+1 trap on the ground at once.

      <i><color=#a89f8a>"Carries
      half a pood of iron on his back."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 2fbd0f86bb322eb46a93110eed83be0b, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 37
    _value: 1
  - _name: Prey in the Snare
    _description: '+15% damage to rooted and slowed targets.

      <i><color=#a89f8a>"Caught?
      Don''t struggle."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 75f1887143655d742b96ceacd807dc24, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 38
    _value: 0.15
  _subclasses:
  - _name: Marksman
    _description: Damage from afar. The last hunter of his village.
