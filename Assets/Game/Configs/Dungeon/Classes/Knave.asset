  - {fileID: 11400000, guid: df41a865c59ca3b408967b5ba6ac96c7, type: 2}
  - {fileID: 11400000, guid: 5660ad9532096c744ab77f365f62354a, type: 2}
  _spells: []
  _perks:
  - _name: Knows Where to Look
    _description: 'Search bodies 50% faster (not chests).

      <i><color=#a89f8a>"Rings
      on the fingers. Coins in the mouth."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 84c26fda299a7ac419ed8b48109e805e, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 63
    _value: 0.5
  - _name: Light-Footed
    _description: '+5% move speed.

      <i><color=#a89f8a>"With a shovel, at a
      run. Without, faster still."</color></i>'
    _modifiers:
    - Stat: 9
      Value: 15
    _icon: {fileID: 21300000, guid: 4bf1fb2cfbc296640b3045835d3f9926, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Nimble Fingers
    _description: '+3 Dexterity.

      <i><color=#a89f8a>"Take the ring without
      waking the widow."</color></i>'
    _modifiers:
    - Stat: 5
      Value: 3
    _icon: {fileID: 21300000, guid: 03a8a74e600bc2042823c716d3de4bb7, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: First Blood
    _description: '+40% damage of the first hit on a foe at full health.

      <i><color=#a89f8a>"The
      first is the one that matters. The second is to be sure."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: de8e70ab9610a214b8610bf4cfaa4a9c, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 64
    _value: 0.4
  - _name: Short Blade
    _description: '+15% damage with daggers and throwing knives.

      <i><color=#a89f8a>"Long
      ones are for duels. Short ones for work."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: d44e90396eb984b42a4d707525f33650, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 65
    _value: 0.15
  - _name: For the Throat
    _description: '+20% damage of hits on the head.

      <i><color=#a89f8a>"A watchman
      screams once. If he gets to."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 65c88dd256301154f986f3a96d8b2ce9, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 66
    _value: 0.2
  - _name: Clean Work
    _description: 'A kill cuts the current cooldowns of your skills by 5s.

      <i><color=#a89f8a>"One
      less. Next."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 0eddef9399659a9459f4f8998e904973, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 67
    _value: 5
  - _name: Thick Venom
    _description: 'Your poison lasts 2s longer.

      <i><color=#a89f8a>"Brew slowly.
      Kill slowly too."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 183f5b0704d9d674e8cbf3559f1d9981, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 68
    _value: 2
  - _name: Caustic Venom
    _description: '+25% damage of your poison.

      <i><color=#a89f8a>"Rats die
      at once. People slower. Fixed that."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 1d0293e52dea6ea4381623125e1a4abe, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 69
    _value: 0.25
  - _name: Weakness
    _description: 'Foes you poison deal 10% less damage.

      <i><color=#a89f8a>"The
      hand still holds the knife. Not firmly."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: e51e6e40eef64ca4e86c08f8e49c76fe, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 70
    _value: 10
  - _name: Rotten Blood
    _description: 'Foes you poison heal half as well.

      <i><color=#a89f8a>"Bandage
      it. Won''t help."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: ad80f3a62a9461b419a47c26adfd7722, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 71
    _value: 50
  - _name: Bundle of Knives
    _description: '+2 throwing weapons in every belt stack.

      <i><color=#a89f8a>"One
      for the dog. The rest for the master."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 93395d2d193686841834ed65bcd9d963, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 72
    _value: 2
  - _name: True Throw
    _description: '+15% damage of throwing weapons.

      <i><color=#a89f8a>"Over
      the fence, in the dark, in the eye."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 8f1f6a4984a28d84f9cd160a5d3e4377, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 73
    _value: 0.15
  - _name: Quick Hand
    _description: 'Throwing weapons are thrown 25% faster.

      <i><color=#a89f8a>"While
      you aim, I''ve already thrown."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: e4b43d4b5c4a3844eb4ef58e382de7af, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 74
    _value: 0.25
  - _name: Oiled Blades
    _description: 'Blade Venom poisons with throwing weapons too.

      <i><color=#a89f8a>"A
      scratch is enough."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: de79cf5058c03704e8ab84fcbfd531b9, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 75
    _value: 1
  _subclasses:
  - _name: Assassin
    _description: 'One target: open it fast, finish it fast. Cut churchyard watchmen
      at night.'
