  m_Script: {fileID: 11500000, guid: d988ee4bac2acf74b80699d6e83c0b70, type: 3}
  m_Name: Knave
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.Dungeon.ClassConfig
  _id: 5
  _displayName: Knave
  _description: 'A grave robber: the Cathedral chased him off every churchyard and
    threatened the stake. The vein is the biggest graveyard in the world, and here
    the same work pays. Takes what the dead wear.'
  _baseStats:
    Strength: 11
    Vitality: 12
    Spirit: 8
    Knowledge: 15
    Agility: 22
    Dexterity: 22
  _color: {r: 0.55, g: 0.6, b: 0.55, a: 1}
  _bodyColor: {r: 1, g: 1, b: 1, a: 1}
