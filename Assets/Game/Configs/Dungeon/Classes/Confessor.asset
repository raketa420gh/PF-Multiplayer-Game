  m_Script: {fileID: 11500000, guid: d988ee4bac2acf74b80699d6e83c0b70, type: 3}
  m_Name: Confessor
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.Dungeon.ClassConfig
  _id: 3
  _displayName: Confessor
  _description: 'A burier of the Cathedral of Repose: sang the dead of the vein to
    rest so they would not rise, and gathered the tithe. Came down himself to atone
    for Mornheim''s "payment of the dead". One wheel of prayers.'
  _baseStats:
    Strength: 15
    Vitality: 14
    Spirit: 21
    Knowledge: 16
    Agility: 12
    Dexterity: 12
  _color: {r: 1, g: 0.9, b: 0.55, a: 1}
  _bodyColor: {r: 1, g: 1, b: 1, a: 1}
  _skills:
  - {fileID: 11400000, guid: 04dd9acdaf9b83647b1df842bad90bfc, type: 2}
