  - {fileID: 11400000, guid: 47ac215e0af4f814fb068a9f7a09a2ef, type: 2}
  - {fileID: 11400000, guid: 0900c985c8bfa404cb1eb90a81a601c2, type: 2}
  - {fileID: 11400000, guid: e335feac1f5a1f6499e4b641d92a6155, type: 2}
  _perks:
  - _name: Firm Faith
    _description: '+3 Spirit.

      <i><color=#a89f8a>"The words are the same. The
      voice is mine."</color></i>'
    _modifiers:
    - Stat: 2
      Value: 3
    _icon: {fileID: 21300000, guid: 348d10be945503745bdd826af95c4389, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Requiem
    _description: '+15% damage to the undead.

      <i><color=#a89f8a>"Sleep. You''ve
      been sung to rest."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 68b36870b4b793b46ae7868a85f0e7e6, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 50
    _value: 0.15
  - _name: Altar Boy
    _description: 'Prayers are cast 10% faster.

      <i><color=#a89f8a>"A hundred
      times a day. The tongue remembers."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 90d0ab331d5f5934789a116a3ce15dd4, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 51
    _value: 0.1
  - _name: Warm Hands
    _description: '+20% to your healing.

      <i><color=#a89f8a>"Everything is
      cold down here. Except the hands."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 23e166821c8b2b6428aea3a6bb7820aa, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 52
    _value: 0.2
  - _name: Shroud
    _description: 'The one you heal takes 10% less damage for 4s.

      <i><color=#a89f8a>"Under
      my hand they won''t touch you."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: d76af35df3cb1034b88c66531c075cc4, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 53
    _value: 10
  - _name: Patience
    _description: '+1 charge to healing prayers.

      <i><color=#a89f8a>"Pray longer
      than it hurts."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 33c69300ac4904e46bf953bb7e7249bd, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 54
    _value: 1
  - _name: Last Rites
    _description: 'Your healing is 30% stronger on allies below 30% health.

      <i><color=#a89f8a>"Not
      today. I''m not ready to bury you."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 97d676df22a55af43bd2546e78b29920, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 55
    _value: 0.3
  - _name: Heavy Hand
    _description: '+10% damage with blunt weapons.

      <i><color=#a89f8a>"Bone
      is not cut. Bone is crushed."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 82163718f609dbd42a067591e97bbfa7, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 56
    _value: 0.1
  - _name: Strength of Faith
    _description: '+3 Strength.

      <i><color=#a89f8a>"Prayed with a mace in hand.
      Holds better."</color></i>'
    _modifiers:
    - Stat: 0
      Value: 3
    _icon: {fileID: 21300000, guid: 5c6c2db982dbe7e4f90a5c272fc0bded, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Righteous Wrath
    _description: 'After you take a hit your next attack deals 20% more damage (at
      most once in 5s).

      <i><color=#a89f8a>"You struck. Here''s my answer."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 9ffd709db1b5d1c49a5f1fb5d08761f0, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 57
    _value: 20
  - _name: Blood Tithe
    _description: 'Every weapon hit heals you for 2% of your health.

      <i><color=#a89f8a>"The
      Cathedral takes a tithe. So do I."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: aec14178f12973f40ba67b26259f19e3, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 58
    _value: 2
  - _name: Blood Prayer
    _description: 'A prayer without charges can be read for 15% of your health.

      <i><color=#a89f8a>"He
      lends. The interest is blood."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: caa45365f46f22b449662d5369f3ec27, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 59
    _value: 15
  - _name: Louder in the Dark
    _description: 'While below half health your prayers deal 15% more damage.

      <i><color=#a89f8a>"The
      less life in me, the louder He is."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 4549153d2b15ec2448c182528229a870, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 60
    _value: 0.15
  - _name: Rot
    _description: 'Foes you curse take 10% more damage from everyone.

      <i><color=#a89f8a>"Rot
      does not choose."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 13205785876c60d42b13b9e5c573aa3e, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 61
    _value: 10
  - _name: Take Back
    _description: 'Killing a cursed foe restores 10% of your health.

      <i><color=#a89f8a>"Given,
      and taken back."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: c68cd56cd8f3c41409e68658e06a550f, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 62
    _value: 10
  _subclasses:
  - _name: Healer
    _description: Heals and shelters the squad. Served the Cathedral's infirmary
      at the entrance; came down to bury fewer.
    _color: {r: 0.6, g: 1, b: 0.65, a: 1}
    _resourceName: 
    _resourceMax: 0
    _resourceSources: 0
    _resourceDecay: 8
    _icon: {fileID: 21300000, guid: 9dc1d844563507645a9c0357d2f19817, type: 3}
  - _name: Smiter
    _description: A mace against the undead. A temple brother of the graveyard guard,
      sent down first when the seal broke.
    _color: {r: 0.95, g: 0.65, b: 0.3, a: 1}
    _resourceName: 
    _resourceMax: 0
    _resourceSources: 0
    _resourceDecay: 8
    _icon: {fileID: 21300000, guid: 1c3ce43200393e44ca773a2f57d20e16, type: 3}
  - _name: Apostate
    _description: Curses, power paid with his own health. Heard the vein breathe
      and went to the Sleepers; his prayers are answered, but not by the Cathedral.
    _color: {r: 0.6, g: 0.3, b: 0.75, a: 1}
    _resourceName: 
    _resourceMax: 0
    _resourceSources: 0
    _resourceDecay: 8
    _icon: {fileID: 21300000, guid: 2bf58d21fd1e19f46a926aea9f10cdc4, type: 3}
