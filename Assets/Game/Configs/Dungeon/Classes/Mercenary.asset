  _spells: []
  _perks:
  - _name: Hardened
    _description: '+10% max health.

      <i><color=#a89f8a>"So many scars there
      is no room for new ones."</color></i>'
    _modifiers:
    - Stat: 6
      Value: 10
    _icon: {fileID: 21300000, guid: f804e792f0da9474bae36dc0ba896e90, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Plate Habit
    _description: 'Heavy armor slows you half as much.

      <i><color=#a89f8a>"Twenty
      years in iron."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: ccf6183bb1d6f204990db15076ae7547, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 1
    _value: 0.5
  - _name: Used to Wounds
    _description: 'Bandages heal 30% more.

      <i><color=#a89f8a>"Bind it tight.
      Walk on."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 410ab3a6bccfc294fbb3fd443ae40168, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 2
    _value: 0.3
  - _name: Steady Stance
    _description: 'Your block does not slow you down.

      <i><color=#a89f8a>"Feet
      first, then the shield."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 721d085e125f54e4a96295008377c517, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 3
    _value: 1
  - _name: Shield Drill
    _description: 'Your shield block stops 20% more damage.

      <i><color=#a89f8a>"The
      shield is a wall, not a plate."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 23d55ad35f33c4045bb58fc9fa97dc26, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 4
    _value: 0.2
  - _name: Counterblow
    _description: 'After a blocked hit your attacks are 25% faster for 2s.

      <i><color=#a89f8a>"Your
      turn is over."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: fd1525608503a254891f628bdb747a45, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 5
    _value: 25
  - _name: Heavy Bones
    _description: 'Nothing can knock you back.

      <i><color=#a89f8a>"Push. I
      will wait."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 2880ab3c34fa81c4c83b084242d3f551, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 6
    _value: 1
  - _name: Anything Sharp
    _description: 'You can wield any weapon.

      <i><color=#a89f8a>"A weapon is
      a weapon."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 349fd2df9d0af6e4d88c090069ee0777, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 7
    _value: 1
  - _name: Light Step
    _description: '+15 move speed while you wear no plate.

      <i><color=#a89f8a>"Iron
      is for the dead."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: feafea265a1e1da4594a7ee9d0002f1a, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 8
    _value: 15
  - _name: Onslaught
    _description: 'Each hit in a row on the same foe makes your attacks 5% faster,
      up to 25%.

      <i><color=#a89f8a>"Don''t let him breathe."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 459aa020de1a32f4fad652d2b9211870, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 9
    _value: 5
  - _name: Quick Hands
    _description: '+5% action speed.

      <i><color=#a89f8a>"Faster than the other
      side."</color></i>'
    _modifiers:
    - Stat: 12
      Value: 5
    _icon: {fileID: 21300000, guid: 292f507b4ba3fd244b9ef7c8e45bd204, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Under the Banner
    _description: 'Allies within 6m get +15 armor.

      <i><color=#a89f8a>"Stay
      in sight of the colours."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: cb1f3326ea061bc4396bbf48f6ef0f8e, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 10
    _value: 15
  - _name: Set the Example
    _description: 'Allies within 6m move 5% faster.

      <i><color=#a89f8a>"Follow
      me."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 0ff470dd98e52224ab24432e91ffbf07, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 11
    _value: 5
  - _name: Battle Order
    _description: 'Allies within 6m deal 5% more damage.

      <i><color=#a89f8a>"Each
      one to his place."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 6012a05fa2ffb4445a8737de8e069f04, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 12
    _value: 5
  - _name: Voice
    _description: 'Your war cries reach 50% farther.

      <i><color=#a89f8a>"Heard
      over any steel."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 74dfd400bec14974eaea988580fb2702, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 13
    _value: 0.5
  _subclasses:
  - _name: Shieldbearer
    _description: Hardest to kill, deals less. Shield only. Held the passes for the
