  _spells: []
  _perks:
  - _name: Hardened
    _description: '+10% max health.

      <i><color=#a89f8a>"So many scars there
      is no room for new ones."</color></i>'
    _modifiers:
    - Stat: 6
      Value: 10
    _icon: {fileID: 21300000, guid: d942bf66c02e1134585b3c806aef36e0, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Plate Habit
    _description: 'Heavy armor slows you half as much.

      <i><color=#a89f8a>"Twenty
      years in iron."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: afe5a533cd25f324b89e89872bec45be, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 1
    _value: 0.5
  - _name: Used to Wounds
    _description: 'Bandages heal 30% more.

      <i><color=#a89f8a>"Bind it tight.
      Walk on."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 26d2816557543644390759b7f3876e1b, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 2
    _value: 0.3
  - _name: Steady Stance
    _description: 'Your block does not slow you down.

      <i><color=#a89f8a>"Feet
      first, then the shield."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 382fea937ea50bd468104935848a6e97, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 3
    _value: 1
  - _name: Shield Drill
    _description: 'Your shield block stops 20% more damage.

      <i><color=#a89f8a>"The
      shield is a wall, not a plate."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 9f67861172e2b9543a7a62aa7812440c, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 4
    _value: 0.2
  - _name: Counterblow
    _description: 'After a blocked hit your attacks are 25% faster for 2s.

      <i><color=#a89f8a>"Your
      turn is over."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 03e471288b6f51b4885bf45c7a512a6a, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 5
    _value: 25
  - _name: Heavy Bones
    _description: 'Nothing can knock you back.

      <i><color=#a89f8a>"Push. I
      will wait."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: c9ba5f02b0c1a044a99335e9c83e3ed8, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 6
    _value: 1
  - _name: Anything Sharp
    _description: 'You can wield any weapon.

      <i><color=#a89f8a>"A weapon is
      a weapon."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 6d998b8343a8b8e44b44475bb0114b65, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 7
    _value: 1
  - _name: Light Step
    _description: '+15 move speed while you wear no plate.

      <i><color=#a89f8a>"Iron
      is for the dead."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 15eb14c6f92fd404fbb9028c7b9b4290, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 8
    _value: 15
  - _name: Onslaught
    _description: 'Each hit in a row on the same foe makes your attacks 5% faster,
      up to 25%.

      <i><color=#a89f8a>"Don''t let him breathe."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 8812240b3501b73438b92d0c97f9a2b2, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 9
    _value: 5
  - _name: Quick Hands
    _description: '+5% action speed.

      <i><color=#a89f8a>"Faster than the other
      side."</color></i>'
    _modifiers:
    - Stat: 12
      Value: 5
    _icon: {fileID: 21300000, guid: fa6e6c7cd9c947942bc1cc9e0b7bc903, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Under the Banner
    _description: 'Allies within 6m get +15 armor.

      <i><color=#a89f8a>"Stay
      in sight of the colours."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 8d0d0f7bd3dd90f4e93a971ab6cf6f78, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 10
    _value: 15
  - _name: Set the Example
    _description: 'Allies within 6m move 5% faster.

      <i><color=#a89f8a>"Follow
      me."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: ae37eabbe9610cc409d9dd0e523b359f, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 11
    _value: 5
  - _name: Battle Order
    _description: 'Allies within 6m deal 5% more damage.

      <i><color=#a89f8a>"Each
      one to his place."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 6f88820281eb2054dacba790c1290b09, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 12
    _value: 5
  - _name: Voice
    _description: 'Your war cries reach 50% farther.

      <i><color=#a89f8a>"Heard
      over any steel."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 534ada0cfc9e12647ae297ec2f8d2138, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 13
    _value: 0.5
