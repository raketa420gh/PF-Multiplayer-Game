  m_Name: Wizard
  m_EditorClassIdentifier: Assembly-CSharp::Game.Scripts.Dungeon.ClassConfig
  _id: 1
  _displayName: Wizard
  _description: 'An outcast bookman: the College above teaches magic by the canon,
    he went for the forbidden books of Mornheim and was thrown out. One wheel of
    spells that come back only by a campfire. Fragile in melee.'
  _baseStats:
    Strength: 8
    Vitality: 10
    Spirit: 23
    Knowledge: 21
    Agility: 15
    Dexterity: 13
