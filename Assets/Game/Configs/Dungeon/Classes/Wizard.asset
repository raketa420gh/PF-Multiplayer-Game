  _perks:
  - _name: Well-Read
    _description: '+3 Knowledge.

      <i><color=#a89f8a>"Copied it by hand, so
      I remember it."</color></i>'
    _modifiers:
    - Stat: 3
      Value: 3
    _icon: {fileID: 21300000, guid: e005fccff3128574688f3bb1d5686309, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Firm Word
    _description: '+3 Spirit.

      <i><color=#a89f8a>"A word weighs what you put
      in it."</color></i>'
    _modifiers:
    - Stat: 2
      Value: 3
    _icon: {fileID: 21300000, guid: 4bd57f92d1f12ae46994356698d1b1be, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Frugal Word
    _description: '15% chance a spell does not spend its charge.

      <i><color=#a89f8a>"Ink
      is dear. So is strength."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 94af2f1b9bc7517498e3a724f61af71e, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 39
    _value: 0.15
  - _name: Hot Flame
    _description: '+15% fire damage.

      <i><color=#a89f8a>"Mornheim burned its
      dead to ash. I learned from the best."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: e24f987397c0e5e4c93d3e3d74b781de, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 40
    _value: 0.15
  - _name: Long Smoulder
    _description: 'Your burning lasts 2s longer.

      <i><color=#a89f8a>"Embers
      remember longer than people."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: b665aeb8f4f9a8244b2f0b71557fd642, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 41
    _value: 2
  - _name: Burnt Hands
    _description: 'Your own fire hurts you 50% less.

      <i><color=#a89f8a>"I
      burned the first hundred pages with my fingers."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 1f7724477f4dad243b641bb59f0528cb, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 24
    _value: 0.5
  - _name: Funeral Heat
    _description: 'A foe killed by your fire bursts into flame: 8 magical damage
      to everyone within 2m.

      <i><color=#a89f8a>"One pyre lights another."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: edb2ec879d65ff143a83e58fa8bbdeff, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 42
    _value: 8
  - _name: Piercing Cold
    _description: 'Your slows are 15% stronger.

      <i><color=#a89f8a>"Cold does
      not strike. Cold waits."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: dcf654bdd2b2b7242a4318b4b15d5568, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 43
    _value: 0.15
  - _name: Brittleness
    _description: 'Foes you slow take 10% more damage from everyone.

      <i><color=#a89f8a>"Frozen
      bone breaks like glass."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 9212356fbdcea674b854c6bdf7a7a882, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 44
    _value: 10
  - _name: Rime on the Skin
    _description: '+10% armor rating.

      <i><color=#a89f8a>"I am not cold. I
      have not been cold for a long time."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 0f473f9715952224991624ed91cee7e3, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 76
    _value: 0.1
  - _name: Winter Memory
    _description: '+1 charge to every frost spell.

      <i><color=#a89f8a>"The
      bone-scholars wrote small. There was room in the margins."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 9ea88e08fb4451a4abba63ccd55871f9, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 45
    _value: 1
  - _name: Dry Air
    _description: '+15% lightning damage.

      <i><color=#a89f8a>"No storms underground.
      So all of it is mine."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 2a1c374b6428eb649972ffe41d338954, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 46
    _value: 0.15
  - _name: Iron Calls
    _description: '+20% lightning damage to foes in plate.

      <i><color=#a89f8a>"Plate
      is the best lightning rod."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: f69e3948231977d4d84e82daff81a13d, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 47
    _value: 0.2
  - _name: Long Chain
    _description: 'Chain lightning leaps to one more body.

      <i><color=#a89f8a>"Let
      it find them itself."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 7c9f68d6f506da94889ac7f8c6c5aef5, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 48
    _value: 1
  - _name: Quick Word
    _description: 'Lightning spells are cast 15% faster.

      <i><color=#a89f8a>"Thunder
      does not wait. Nor do I."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: cb96c90be05bd3d458dba0dc7c25a238, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 49
    _value: 0.15
  _subclasses:
  - _name: Flamer
    _description: 'Area damage and burning. Copied the funeral books of Mornheim:
      whom the vein would not take, the empire burned.'
