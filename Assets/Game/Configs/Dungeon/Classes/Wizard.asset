  _perks:
  - _name: Well-Read
    _description: '+3 Knowledge.

      <i><color=#a89f8a>"Copied it by hand, so
      I remember it."</color></i>'
    _modifiers:
    - Stat: 3
      Value: 3
    _icon: {fileID: 21300000, guid: 28132ab888831364da0f3cb0c53b2b45, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Firm Word
    _description: '+3 Spirit.

      <i><color=#a89f8a>"A word weighs what you put
      in it."</color></i>'
    _modifiers:
    - Stat: 2
      Value: 3
    _icon: {fileID: 21300000, guid: a76aebabd5063674aa5bdb71553365bd, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 0
    _value: 0
  - _name: Frugal Word
    _description: '15% chance a spell does not spend its charge.

      <i><color=#a89f8a>"Ink
      is dear. So is strength."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 7a1284e4b55d3044b947fb3d4dcca6f4, type: 3}
    _subclass: -1
    _isPerStack: 0
    _effect: 39
    _value: 0.15
  - _name: Hot Flame
    _description: '+15% fire damage.

      <i><color=#a89f8a>"Mornheim burned its
      dead to ash. I learned from the best."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 940c417d4cde1364e98a8014455a9e17, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 40
    _value: 0.15
  - _name: Long Smoulder
    _description: 'Your burning lasts 2s longer.

      <i><color=#a89f8a>"Embers
      remember longer than people."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 0e3558553f5f7f24abda5a800b71a6f1, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 41
    _value: 2
  - _name: Burnt Hands
    _description: 'Your own fire hurts you 50% less.

      <i><color=#a89f8a>"I
      burned the first hundred pages with my fingers."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 545d9fea4f4f6a948b5a8d4713c9f975, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 24
    _value: 0.5
  - _name: Funeral Heat
    _description: 'A foe killed by your fire bursts into flame: 8 magical damage
      to everyone within 2m.

      <i><color=#a89f8a>"One pyre lights another."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 52775701a8256754eb1984cff6d1df44, type: 3}
    _subclass: 0
    _isPerStack: 0
    _effect: 42
    _value: 8
  - _name: Piercing Cold
    _description: 'Your slows are 15% stronger.

      <i><color=#a89f8a>"Cold does
      not strike. Cold waits."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 774bb96a4b7b10b4299da676ce0553b6, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 43
    _value: 0.15
  - _name: Brittleness
    _description: 'Foes you slow take 10% more damage from everyone.

      <i><color=#a89f8a>"Frozen
      bone breaks like glass."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: a059b2fb3f780c541b353d9c83e1a643, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 44
    _value: 10
  - _name: Rime on the Skin
    _description: '+10% armor rating.

      <i><color=#a89f8a>"I am not cold. I
      have not been cold for a long time."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: cbca6c56465bfc3448deb04b8aad8080, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 76
    _value: 0.1
  - _name: Winter Memory
    _description: '+1 charge to every frost spell.

      <i><color=#a89f8a>"The
      bone-scholars wrote small. There was room in the margins."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: b4967e79b9f4d9b40b9b57e20f6f5c31, type: 3}
    _subclass: 1
    _isPerStack: 0
    _effect: 45
    _value: 1
  - _name: Dry Air
    _description: '+15% lightning damage.

      <i><color=#a89f8a>"No storms underground.
      So all of it is mine."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: c4d473bb8db87e84694c721954fdf090, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 46
    _value: 0.15
  - _name: Iron Calls
    _description: '+20% lightning damage to foes in plate.

      <i><color=#a89f8a>"Plate
      is the best lightning rod."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: d1abedb9a184100438b83dac3380ab05, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 47
    _value: 0.2
  - _name: Long Chain
    _description: 'Chain lightning leaps to one more body.

      <i><color=#a89f8a>"Let
      it find them itself."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: 6f76313de50444440a9eb388e610b591, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 48
    _value: 1
  - _name: Quick Word
    _description: 'Lightning spells are cast 15% faster.

      <i><color=#a89f8a>"Thunder
      does not wait. Nor do I."</color></i>'
    _modifiers: []
    _icon: {fileID: 21300000, guid: e37c1a3f9e5fe1441aa5d94996c15921, type: 3}
    _subclass: 2
    _isPerStack: 0
    _effect: 49
    _value: 0.15
  _subclasses:
  - _name: Flamer
    _description: 'Area damage and burning. Copied the funeral books of Mornheim:
      whom the vein would not take, the empire burned.'
