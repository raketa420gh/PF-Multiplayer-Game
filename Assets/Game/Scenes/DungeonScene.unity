  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Controls</b>\nWASD move \xB7 Shift walk (quiet) \xB7 Space jump \xB7
    Ctrl/C crouch (duck under swings)\nLMB attack / draw \xB7 RMB block, or hold
    to cast a readied spell \xB7 1 / 2 weapon sets \xB7 Tab inventory\nF interact
    (hold) \xB7 Q / E skills (hold a Memory skill for the spell / form wheel) \xB7
    5 6 7 8 belt \xB7 G rest \xB7 H help\nCasters need a staff, spellbook or crystal
    ball in hand; bards need an instrument. Rest at a campfire to recover charges."
  m_isRightToLeft: 0
